# ============================================================
# Variables de Entorno para docker-compose.yml
# Plataforma Educativa Móvil Cacique Tamanaco
# ============================================================
# Copie este archivo como .env en la misma carpeta donde
# se encuentra docker-compose.yml y ajuste los valores.
# ============================================================

# ----------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------
POSTGRES_USER=cacique_admin
POSTGRES_PASSWORD=cacique_secret_2024
POSTGRES_DB=cacique_tamanaco_db

# ----------------------------------------------------------
# Backend (Express)
# ----------------------------------------------------------
PORT=3000

# ----------------------------------------------------------
# Base de Datos (backend - debe apuntar al servicio postgres)
# NOTA: DB_HOST debe ser el nombre del servicio en compose
# ----------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=${POSTGRES_DB}
DATABASE_USER=${POSTGRES_USER}
DATABASE_PASSWORD=${POSTGRES_PASSWORD}

# ----------------------------------------------------------
# JWT
# ----------------------------------------------------------
JWT_SECRET=cacique_tamanaco_secret_key_2024

# ----------------------------------------------------------
# Cifrado AES-256
# ENCRYPTION_KEY : 32 caracteres exactos (256 bits)
# ENCRYPTION_IV  : 16 caracteres exactos (128 bits)
# ----------------------------------------------------------
ENCRYPTION_KEY=cacique_tamanaco_encryption_key_32b!
ENCRYPTION_IV=cacique_tamanaco_iv_16b

# ----------------------------------------------------------
# Uploads
# ----------------------------------------------------------
UPLOADS_DIR=./uploads/entregas

# ----------------------------------------------------------
# CORS — Orígenes permitidos (separados por coma si son varios)
# Producción: https://tudominio.com
# ----------------------------------------------------------
CORS_ORIGIN=http://localhost:4200

# ----------------------------------------------------------
# Logging — Nivel: debug | info | warn | error
# ----------------------------------------------------------
LOG_LEVEL=debug

# ----------------------------------------------------------
# Frontend (Angular PWA - servido por nginx en puerto 80)
# NOTA: El frontend NO necesita variables de entorno.
#       El proxy reverso de nginx (/api/* → backend:3000)
#       maneja la comunicación con la API automáticamente.
#       Las variables apiUrl en Angular se resuelven como
#       rutas relativas (/api) que nginx captura.
# ----------------------------------------------------------
# (No se requieren variables adicionales para frontend)

# ----------------------------------------------------------
# Credencial por defecto del administrador (seed)
# ----------------------------------------------------------
ADMIN_DEFAULT_PASSWORD=admin
