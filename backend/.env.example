# ============================================================
# Configuración del Backend - Plataforma Educativa Móvil
# Cacique Tamanaco
# ============================================================
# Copie este archivo como .env y ajuste los valores según
# su entorno local o de producción.
# ============================================================

# ----------------------------------------------------------
# Servidor Express
# ----------------------------------------------------------
PORT=3000

# ----------------------------------------------------------
# Base de Datos PostgreSQL
# ----------------------------------------------------------
# NOTA: En docker-compose DATABASE_HOST debe ser "postgres"
#       (nombre del servicio de base de datos en la red interna)
# ----------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cacique_tamanaco_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ----------------------------------------------------------
# JWT (Autenticación)
# ----------------------------------------------------------
JWT_SECRET=my_super_secret_jwt_key_change_in_production

# ----------------------------------------------------------
# Cifrado AES-256 (Módulo de Criptografía)
# ENCRYPTION_KEY : 32 caracteres exactos (256 bits)
# ENCRYPTION_IV  : 16 caracteres exactos (128 bits)
# ----------------------------------------------------------
ENCRYPTION_KEY=abcdefghijklmnopqrstuvwxyz123456
ENCRYPTION_IV=abcdefghijklmnop

# ----------------------------------------------------------
# Directorio de subida de archivos
# ----------------------------------------------------------
UPLOADS_DIR=./uploads/entregas

# ----------------------------------------------------------
# Credencial por defecto del administrador (seed)
# Se utiliza únicamente en el primer despliegue.
# ----------------------------------------------------------
ADMIN_DEFAULT_PASSWORD=admin